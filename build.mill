      * No `libs/security-core` here, unlike the schema service's: this service has no mutation, so there is
      * no audit record for it to hold and no `Principal` for it to keep. The day it acquires one, that
      * dependency arrives with it.
      */
    object application extends KuiJvmModule {
      def moduleDeps = Seq(domain)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}"
      )

      object test extends KuiCoverageTests {
