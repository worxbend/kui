          mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
          mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
          mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
