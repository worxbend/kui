  /** `kui-alerts-service`: the rules KUI runs over facts it already measures, and the feed they open.
    *
    * The **ninth** service, and the first written against the worked example rather than inventing one. It
    * is the metrics service's shape with two differences that are the whole of M8: it keeps a **store**,
    * because "a log directory crossed 80% an hour ago" is a fact with a lifetime and a `SnapshotCell` only
    * ever holds a now; and it has one **mutation**, because acknowledging an alert is a write somebody has
    * to be named for.
    *
    * It holds a Kafka admin client. The facts its rules read — offline partitions, under-replicated
    * partitions, a group stuck rebalancing, a log directory past a threshold — are all `AdminClient` facts,
    * and reading them through another KUI service would make one service's rules a property of another
    * service's paging (`KafkaPartitionSweeper`'s own argument, one service over).
    */
  object alerts extends Module {

    /** The rules themselves, and nothing that can perform I/O.
      *
      * Rule A1 allows it `libs/kernel` and cats-core, nothing else — and that is load bearing here rather
      * than incidental: `AlertThresholds` lives in `libs/config`, which the domain may not see, so the fold
      * takes an `AlertLimits` of its own and the composition root maps between them. The alternative would
      * be a rules engine that could not be evaluated without a configuration file, which is a rules engine
      * nobody can test one rule at a time.
      */
    object domain extends KuiPureModule with KuiJvmModule {
      def moduleDeps = Seq(libs.kernel.jvm)
      def mvnDeps    = Seq(mvn"org.typelevel::cats-core::${Versions.cats}")

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)
      }
    }

    /** The use cases: read the feed, acknowledge one event, run one evaluation pass.
      *
      * `libs.securityCore.jvm` is here for `Principal`, `MutationOutcome` and `AuditPrincipal`, which
      * ADR-047 declares once for every service that writes an audit record rather than once per service —
      * the same edge the consumer and topic services declare, and for the same reason. `fs2-core` is here
      * for `AlertStore.changes`, which is what makes the bell and the card read one source (ADR-035).
      */
    object application extends KuiJvmModule {
      def moduleDeps = Seq(domain, libs.securityCore.jvm)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}"
        )
      }
    }

    /** The adapters: the admin calls the rules read, the store the events live in, and the audit line an
      * acknowledgement writes.
      *
      * `libs.cache` carries the `BoundedCache` the per-principal read markers are held in — one entry per
      * principal per cluster, bounded, so a feed that a thousand people watch cannot grow without limit.
      */
    object infrastructure extends KuiJvmModule {
      def moduleDeps =
        Seq(domain, application, libs.kafka, libs.config, libs.cache, libs.kernel.jvm, libs.observability)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}"
        )
      }
    }

    /** Server logic: contract to application, `KuiError` to the HTTP envelope, principal verification, the
      * SSE endpoint that cannot be cross-compiled, and the OpenAPI document. It starts nothing.
      */
    object api extends KuiJvmModule {
      def moduleDeps = Seq(
        application,
        contract.jvm,
        libs.kernel.jvm,
        libs.contractsCore.jvm,
        libs.securityCore.jvm,
        libs.observability,
        libs.http
      )

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-cats-effect::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-openapi-docs::${Versions.tapir}",
        mvn"com.softwaremill.sttp.apispec::openapi-circe::${Versions.apispec}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      private def openApiTarget: String = (moduleDir / "openapi.json").toString

      def openApi(): Command[Unit] = Task.Command {
        runDocumentMain("kui.alerts.api.OpenApiDocument", openApiTarget)()
      }

      def openApiCheck(): Command[Unit] = Task.Command {
        runDocumentMain("kui.alerts.api.OpenApiDocument", openApiTarget, "--check")()
      }

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // The stub interpreter runs the real interceptor chain and the real routes without a socket,
          // which is the only way to assert that a permission refusal happens *before* the store is
          // written rather than that a use case would have refused if it had been called.
          mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
          mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
          mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
          mvn"io.circe::circe-parser::${Versions.circe}"
        )
      }
    }

    /** The composition root: the one place in the alerts service that constructs anything concrete. */
    object app extends KuiJvmModule {
      def moduleDeps =
        Seq(api, infrastructure, libs.cache, libs.config, libs.kafka, libs.observability, libs.http, services.cluster.client)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-io::${Versions.fs2}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      /** The same runtime set every KUI process needs: a logging backend, a JSON encoder for it and the
        * telemetry exporters. None is named in code, and all are needed by a process with a `main`.
        */
      def runMvnDeps = Seq(
        mvn"ch.qos.logback:logback-classic:${Versions.logback}",
        mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
        mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
        mvn"io.opentelemetry:opentelemetry-exporter-prometheus:${Versions.otelSdk}-alpha"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // Virtual time: the evaluation loop's whole contract is about what has happened after an
          // interval, and a suite that slept through one would be slow and flaky at once.
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
        )
      }
    }

    /** The published wire shape of `kui-alerts-service`, cross-compiled so the browser decodes exactly what
      * this service encodes, from one source (ADR-003).
      */
    object contract extends Module {

      trait Shared extends KuiModule with PlatformScalaModule {
        def mvnDeps = Seq(
          mvn"org.typelevel::cats-core::${Versions.cats}",
          mvn"io.circe::circe-core::${Versions.circe}",
          mvn"io.circe::circe-parser::${Versions.circe}",
          mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
          mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}"
        )
      }

      object jvm extends Shared with KuiJvmModule {
        def moduleDeps = Seq(libs.contractsCore.jvm, libs.securityCore.jvm)

        // `src-jvm` holds the one endpoint that cannot be cross-compiled: the change stream, whose
        // body is an event stream and therefore needs `fs2` and a stream capability. It is in the
        // *contract* module rather than in `api` because the gateway may see a service only through
        // its published contract (rules A4 and A11), and the gateway is what has to hold this
        // endpoint value in order to relay it — `services/message`'s browse stream is in the same
        // position for the same reason. The browser loses nothing: it opens the address with
        // `EventSource`, and the frames' DTO is declared in the shared sources.
        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"co.fs2::fs2-core::${Versions.fs2}",
          // For `sttp.capabilities.fs2.Fs2Streams`. It arrives through the sttp client's fs2
          // module, which is the coordinate this build already pins for it everywhere else.
          mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}"
        )

        object test extends KuiCoverageTests with KuiCrossTests
      }

    }
  }

  /** `kui-connect-service`: the connectors a Kafka Connect cluster is running, and the three buttons.
    *
    * The **tenth** service, and the second written against `services/metrics` as the worked example rather
    * than inventing a shape. It differs from the metrics service in one way and from the alerts service in
    * another, and both differences are visible in the module list below.
    *
    * It holds **no Kafka client**. Every fact it reports comes from the Connect workers' REST API, which is
    * why `libs.kafka` appears nowhere here and `services/schema` — the other service whose whole subject is
    * an HTTP upstream — is what its `infrastructure` module looks like.
    *
    * It keeps **no store**. A connector's state is a fact the worker holds and KUI reads; there is nothing
    * with a lifetime for KUI to remember, so there is no buffer, no evaluation loop and no retention. That is
    * also what decides the answer to "what does an operator see while a restart is in flight": the next read
    * of the worker, and ADR-054 §5 says so rather than implying a stream that does not exist.
    */
  object connect extends Module {

    /** What a connector and its tasks *are*, and nothing that can perform I/O.
      *
      * Rule A1 allows it `libs/kernel` and cats-core. `ConnectName`, `ConnectorName` and `TaskId` are all
      * `libs/kernel` types shipped in wave 1 and unused until now, so the domain names a connector the way
      * the rest of the product already does rather than passing strings.
      */
    object domain extends KuiPureModule with KuiJvmModule {
      def moduleDeps = Seq(libs.kernel.jvm)
      def mvnDeps    = Seq(mvn"org.typelevel::cats-core::${Versions.cats}")

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)
      }
    }

    /** The use cases: list the connectors of every configured worker, and pause, resume or restart one.
      *
      * `libs.securityCore.jvm` is here for `Principal`, `MutationOutcome` and `AuditPrincipal`, which ADR-047
      * declares once for every service that writes an audit record — the same edge the consumer, topic and
      * alerts services declare, and for the same reason.
      */
    object application extends KuiJvmModule {
      def moduleDeps = Seq(domain, libs.securityCore.jvm)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}"
        )
      }
    }

    /** The adapters: the Connect REST API, the credentials each worker wants, and the audit line an
      * operation writes.
      *
      * `libs.config` carries `ConnectClusterSettings`, which is the only place the workers' addresses exist.
      * There is no `libs.cache` and no `libs.kafka`: nothing here is remembered between requests and nothing
      * here speaks to a broker.
      */
    object infrastructure extends KuiJvmModule {
      def moduleDeps = Seq(domain, application, libs.config, libs.kernel.jvm, libs.http, libs.observability)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"io.circe::circe-parser::${Versions.circe}",
        mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}"
        )
      }
    }

    /** Server logic: contract to application, `KuiError` to the HTTP envelope, principal verification and the
      * OpenAPI document. It starts nothing.
      */
    object api extends KuiJvmModule {
      def moduleDeps = Seq(
        application,
        contract.jvm,
        libs.kernel.jvm,
        libs.contractsCore.jvm,
        libs.securityCore.jvm,
        libs.observability,
        libs.http
      )

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-cats-effect::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-openapi-docs::${Versions.tapir}",
        mvn"com.softwaremill.sttp.apispec::openapi-circe::${Versions.apispec}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      private def openApiTarget: String = (moduleDir / "openapi.json").toString

      def openApi(): Command[Unit] = Task.Command {
        runDocumentMain("kui.connect.api.OpenApiDocument", openApiTarget)()
      }

      def openApiCheck(): Command[Unit] = Task.Command {
        runDocumentMain("kui.connect.api.OpenApiDocument", openApiTarget, "--check")()
      }

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // The stub interpreter runs the real interceptor chain and the real routes without a socket,
          // which is the only way to assert that a permission refusal happens *before* the worker is
          // called rather than that a use case would have refused if it had been reached.
          mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
          mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
          mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
          mvn"io.circe::circe-parser::${Versions.circe}"
        )
      }
    }

    /** The composition root: the one place in the connect service that constructs anything concrete. */
    object app extends KuiJvmModule {
      def moduleDeps = Seq(api, infrastructure, libs.config, libs.observability, libs.http)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-io::${Versions.fs2}",
        mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      /** The same runtime set every KUI process needs: a logging backend, a JSON encoder for it and the
        * telemetry exporters. None is named in code, and all are needed by a process with a `main`.
        */
      def runMvnDeps = Seq(
        mvn"ch.qos.logback:logback-classic:${Versions.logback}",
        mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
        mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
        mvn"io.opentelemetry:opentelemetry-exporter-prometheus:${Versions.otelSdk}-alpha"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}"
        )
      }
    }

    /** The published wire shape of `kui-connect-service`, cross-compiled so the browser decodes exactly what
      * this service encodes, from one source (ADR-003).
      *
      * There is no `src-jvm` here and no stream endpoint. Connect publishes no change feed of its own — its
      * REST API is poll-only — so there is nothing to relay and house rule 16 has nothing to ask for.
      * ADR-054 §5 states that as a decision with its cost rather than leaving it to be inferred from an
      * absent file.
      */
    object contract extends Module {

      trait Shared extends KuiModule with PlatformScalaModule {
        def mvnDeps = Seq(
          mvn"org.typelevel::cats-core::${Versions.cats}",
          mvn"io.circe::circe-core::${Versions.circe}",
          mvn"io.circe::circe-parser::${Versions.circe}",
          mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
          mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}"
        )
      }

      object jvm extends Shared with KuiJvmModule {
        def moduleDeps = Seq(libs.contractsCore.jvm, libs.securityCore.jvm)

        object test extends KuiCoverageTests with KuiCrossTests
      }

    }
  }

  /** `kui-ksql-service`: ksqlDB's streams, tables and queries, one statement at a time, and a push query
    * that is genuinely a stream.
    *
    * The **eleventh** and last new service in this plan, written against `services/connect` as the worked
    * example because the two have the same shape: an optional HTTP upstream per cluster, no Kafka client of
    * its own, and nothing remembered between requests. It differs from it in exactly two ways, and both are
    * visible in the module list below.
    *
    * It has a **stream**, and the stream's endpoint therefore lives in the contract module's JVM half —
    * `services/alerts` and `services/message` are in the same position and for the same reason: the gateway
    * may see a service only through its published contract (rules A4, A11), and a relay has to be written
    * against an endpoint value the gateway can hold. House rule 16 is what makes that a requirement rather
    * than a preference.
    *
    * It has a **destructive mutation**, so `application` carries a plan token (ADR-045) and needs a signing
    * key — `services/topic` is the shape that was copied, down to reusing ADR-026's cursor key so that a
    * deployment configures one secret rather than two.
    */
  object ksql extends Module {

    /** What a ksqlDB object and a ksqlDB statement *are*, and nothing that can perform I/O.
      *
      * Rule A1 allows it `libs/kernel` and cats-core. The statement classifier lives here rather than in
      * `infrastructure` because "is this a push query" and "does this drop a topic" are decisions the whole
      * service is shaped around — the first decides which endpoint answers, the second decides whether a
      * plan token is required — and a decision taken in an adapter is one the use case cannot assert.
      */
    object domain extends KuiPureModule with KuiJvmModule {
      def moduleDeps = Seq(libs.kernel.jvm)
      def mvnDeps    = Seq(mvn"org.typelevel::cats-core::${Versions.cats}")

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)
      }
    }

    /** The use cases: list the objects, run one statement, plan a destructive one, and open a push query.
      *
      * `libs.securityCore.jvm` is here for `Principal`, `MutationOutcome` and `AuditPrincipal`, which ADR-047
      * declares once for every service that writes an audit record. `fs2` is here because a push query *is* a
      * stream of rows and the use case is what produces it; the SSE framing stays in `api`.
      */
    object application extends KuiJvmModule {
      def moduleDeps = Seq(domain, libs.kernel.jvm, libs.securityCore.jvm)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}"
        )
      }
    }

    /** The adapters: ksqlDB's REST API, the credentials it wants, and the audit line a statement writes.
      *
      * `libs.config` carries `KsqlSettings`, which is the only place a ksqlDB address exists. There is no
      * `libs.cache` and no `libs.kafka`: nothing here is remembered between requests and nothing here speaks
      * to a broker.
      */
    object infrastructure extends KuiJvmModule {
      def moduleDeps = Seq(domain, application, libs.config, libs.kernel.jvm, libs.http, libs.observability)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"io.circe::circe-parser::${Versions.circe}",
        mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // Virtual time, declared by W11-A1 in its first hour and landed here (house rule 15).
          // `KsqlCredentials` replaces an OAuth token a `RefreshMargin` BEFORE its stated expiry so
          // that no request is ever made with a token that dies in flight. That margin is thirty
          // seconds of wall clock: a suite that proved it by sleeping would take half a minute and
          // still be a race, and the mutation that deletes the margin is green without a clock to
          // read it against.
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
        )
      }
    }

    /** Server logic: contract to application, `KuiError` to the HTTP envelope, principal verification, the
      * SSE framing and the OpenAPI document. It starts nothing.
      */
    object api extends KuiJvmModule {
      def moduleDeps = Seq(
        application,
        contract.jvm,
        libs.kernel.jvm,
        libs.contractsCore.jvm,
        libs.securityCore.jvm,
        libs.observability,
        libs.http
      )

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-core::${Versions.fs2}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-cats-effect::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-openapi-docs::${Versions.tapir}",
        mvn"com.softwaremill.sttp.apispec::openapi-circe::${Versions.apispec}",
        mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      private def openApiTarget: String = (moduleDir / "openapi.json").toString

      def openApi(): Command[Unit] = Task.Command {
        runDocumentMain("kui.ksql.api.OpenApiDocument", openApiTarget)()
      }

      def openApiCheck(): Command[Unit] = Task.Command {
        runDocumentMain("kui.ksql.api.OpenApiDocument", openApiTarget, "--check")()
      }

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // The stub interpreter runs the real interceptor chain and the real routes without a socket,
          // which is the only way to assert that a permission refusal happens *before* the ksqlDB server
          // is called rather than that a use case would have refused if it had been reached.
          mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
          mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
          mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
          mvn"io.circe::circe-parser::${Versions.circe}"
        )
      }
    }

    /** The composition root: the one place in the ksql service that constructs anything concrete. */
    object app extends KuiJvmModule {
      def moduleDeps = Seq(api, infrastructure, libs.config, libs.observability, libs.http)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"co.fs2::fs2-io::${Versions.fs2}",
        mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
        mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
        mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      /** The same runtime set every KUI process needs: a logging backend, a JSON encoder for it and the
        * telemetry exporters. None is named in code, and all are needed by a process with a `main`.
        */
      def runMvnDeps = Seq(
        mvn"ch.qos.logback:logback-classic:${Versions.logback}",
        mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
        mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
        mvn"io.opentelemetry:opentelemetry-exporter-prometheus:${Versions.otelSdk}-alpha"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}"
        )
      }
    }

    /** The published wire shape of `kui-ksql-service`, cross-compiled so the browser decodes exactly what
      * this service encodes, from one source (ADR-003).
      */
    object contract extends Module {

      trait Shared extends KuiModule with PlatformScalaModule {
        def mvnDeps = Seq(
          mvn"org.typelevel::cats-core::${Versions.cats}",
          mvn"io.circe::circe-core::${Versions.circe}",
          mvn"io.circe::circe-parser::${Versions.circe}",
          mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
          mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}"
        )
      }

      object jvm extends Shared with KuiJvmModule {
        def moduleDeps = Seq(libs.contractsCore.jvm, libs.securityCore.jvm)

        // `src-jvm` holds the one endpoint that cannot be cross-compiled: the push query, whose body is
        // an event stream and therefore needs `fs2` and a stream capability. It is in the *contract*
        // module rather than in `api` because the gateway may see a service only through its published
        // contract (rules A4 and A11), and the gateway is what has to hold this endpoint value in order
        // to relay it — `services/alerts` and `services/message` are in the same position. The browser
        // loses nothing: it opens the address with `EventSource`, and the frames' DTOs are declared in
        // the shared sources.
        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"co.fs2::fs2-core::${Versions.fs2}",
          // For `sttp.capabilities.fs2.Fs2Streams`. It arrives through the sttp client's fs2 module,
          // which is the coordinate this build already pins for it everywhere else.
          mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}"
        )

        object test extends KuiCoverageTests with KuiCrossTests
      }

    }
  }

}

/** Deployable processes assembled out of the modules above.
  *
  * A service's own `app` module is one deployable; this is the other kind — a process that composes
  * several services rather than serving one. `apps/allinone` is the only member in M0 and the only
  * one planned: ADR-005's whole argument is that there should be exactly two deployment shapes, and
  * that both should run the same code.
  *
  * It is deliberately not under `services`, and the layering rules of ADR-041 are why. Rule A4 forbids
  * anything under `services.gateway` from reaching into another service's private layers, which is what
  * keeps the gateway a composition layer over published contracts. The all-in-one process must do exactly
  * that reaching — it constructs each service's server logic in its own JVM — so it cannot live inside the
  * gateway, and it is not a service either. `apps` is the honest name for what it is: a composition root
  * one level above every service, which is the only place in the build allowed to know all of them.
  */
object apps extends Module {

  /** The whole product in one process, on one port (ADR-005, AIO-001).
    *
    * It depends on the gateway's composition root and on every service's, because composing them is
    * precisely its job. That set of dependencies grows by one service per milestone and nothing else
    * about this module changes.
    */
  object allinone extends KuiJvmModule {
    override def moduleDir = mill.api.BuildCtx.workspaceRoot / "apps" / "allinone"

    def moduleDeps = Seq(
      services.gateway.app,
      services.gateway.api,
      services.gateway.application,
      services.cluster.app,
      services.cluster.api,
      services.cluster.client,
      services.topic.app,
      services.topic.api,
      services.consumer.app,
      services.consumer.api,
      services.message.app,
      services.message.api,
      // The identity service, so that a deployment on one port can still be one somebody signs in to.
      services.identity.app,
      services.identity.api,
      services.schema.app,
      services.schema.api,
      // The metrics service, which measures nothing yet and says so per cluster. It is in this binary
      // for the reason the schema service is: "this deployment has no metrics source" is an answer the
      // dashboard needs from a running service, and a service left out of the process would instead look
      // like a service that is down.
      services.metrics.app,
      services.metrics.api,
      // The alerts service, whose rules read facts this binary is already reading for four other
      // services. It is here rather than optional because the bell in the frame is drawn on every
      // screen: a deployment without this service would draw a bell nothing can ever answer for.
      services.alerts.app,
      services.alerts.api,
      // The connect service, whose answer for a deployment that configures no Connect worker is
      // `not_configured` per cluster — which is a fact the drawer needs from a running service, exactly as
      // it is for the schema and metrics services. This edge is landed with the module rather than by the
      // packet that writes the `AllInOneWiring` entry, because that packet does not own `build.mill` and
      // an edge with no owner is invisible to every gate here (house rule 15).
      services.connect.app,
      services.connect.api,
      // The ksql service, the eleventh. Same argument as the connect service's, plus one of its own: it
      // is the only optional service in this binary that serves a *stream*, so a deployment that left it
      // out would draw a ksqlDB screen whose push query opens a socket to nothing. The edge is landed
      // with the module rather than by the packet that writes the `AllInOneWiring` entry, because that
      // packet does not own `build.mill` (house rule 15).
      services.ksql.app,
      services.ksql.api,
      libs.config,
      libs.observability,
      libs.http
    )

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::${Versions.cats}",
      mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
      mvn"co.fs2::fs2-core::${Versions.fs2}",
      mvn"com.softwaremill.macwire::util::${Versions.macwire}",
      mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
      mvn"com.softwaremill.sttp.tapir::tapir-server::${Versions.tapir}",
      // The in-memory transport. `tapir-sttp-stub4-server` is what lets the gateway's own sttp client
      // speak to a service's server logic without a socket, which is how ADR-005's "no second code
      // path" is achieved rather than merely intended. It is a compile dependency of the production
      // code here, not of a test: in this deployment shape it *is* the transport.
      mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
      mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
      mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
      mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
      mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
      mvn"com.softwaremill.sttp.tapir::tapir-netty-server-cats::${Versions.tapir}"
    )

    /** The same runtime set every KUI process needs: a logging backend, a JSON encoder for it and the
      * telemetry exporters. None is named in code — Logback is configured by the XML in
      * `libs/observability`'s resources and the exporters by OpenTelemetry's autoconfigure mechanism —
      * so they stay off the compile classpath.
      */
    def runMvnDeps = Seq(
      mvn"ch.qos.logback:logback-classic:${Versions.logback}",
      mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
      mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
      mvn"io.opentelemetry:opentelemetry-exporter-prometheus:${Versions.otelSdk}-alpha"
    )

    object test extends KuiCoverageTests {
      // The identity service's `infrastructure`, for one thing only: `SignInSeamSuite` needs a real
      // password hash to configure an account with, and hashing one with the product's own key
      // derivation function is more honest than pasting a constant that could drift from the format.
      def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, services.identity.infrastructure)

      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
        mvn"org.typelevel::otel4s-oteljava-testkit::${Versions.otel4s}",
        mvn"ch.qos.logback:logback-classic:${Versions.logback}",
        mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}"
      )
    }
  }
}

/** The container images KUI ships, and the conventions every future one inherits.
  *
  * Three images in M0 — `kui-gateway`, `kui-cluster` and `kui-allinone` — and each is a thin wrapper
  * around a deployable `app` module rather than something that module grows itself. Keeping them here
  * means "how KUI is packaged" is one file to read and one place to change, and it means adding the
  * eighth service's image is four lines rather than four lines copied into a service's own build
  * definition where nobody will find them.
  *
  * The conventions below are decided once, in [[deployment.docker.KuiImage]], and they are the ones
  * INFRA-001 fixes for every image KUI will ever publish.
  */
object deployment extends Module {

  object docker extends Module {

    /** Where a mounted configuration file is expected, and what the images say to run without one. */
    val ConfigPath: String = "/etc/kui/kui.yaml"

    /** One deployable process, packaged.
      *
      * Every image is `eclipse-temurin:21-jre` (ADR-001) with one assembled jar in it and nothing
      * else. The conventions, and why each one is what it is:
      *
      *   - **Non-root, uid 1001.** A container process that is root is root on the host kernel if
      *     anything ever escapes the namespace, and nothing KUI does needs privilege.
      *
      *     The uid is written numerically and no user is created for it, which is a deliberate
      *     trade. `useradd` would give `whoami` an answer, and it would also write the current day
      *     number into `/etc/shadow` — so the same commit would produce a different image tomorrow,
      *     and the reproducibility this task also asks for would be gone. A numeric `USER` costs a
      *     confusing `whoami` and buys an image that is a function of its source. `HOME` is set to
      *     `/tmp` so that anything looking for a home directory finds a writable one.
      *
      *   - **`-XX:MaxRAMPercentage=75`.** The JVM's default heap sizing reads the *host's* memory on
      *     older runtimes and a container's limit on newer ones; saying it explicitly means the heap
      *     is a stated fraction of whatever limit the orchestrator applied, on every runtime.
      *
      *   - **`-XX:+ExitOnOutOfMemoryError`.** An out-of-memory JVM does not recover; it thrashes,
      *     answers slowly, and passes its own liveness probe while doing it. Exiting turns a silent
      *     degradation into a restart the orchestrator can see and an operator can alert on.
      *
      *   - **`-Djava.io.tmpdir=/tmp`.** Explicit because the images are meant to run with a read-only
      *     root filesystem and a tmpfs at `/tmp`; see `deployment/docker/README.md` for the flags.
      *
      *   - **`HEALTHCHECK` on the liveness endpoint.** `curl` is already in the base image, so this
      *     costs no extra layer and no package installation — which also means no `apt-get`, which is
      *     the other thing that would have made the image a function of the day it was built.
      *
      *   - **The configuration is mounted, never baked in.** The default command names
      *     [[ConfigPath]] and the file is not in the image, so a container started without the mount
      *     stops with the configuration problem printed rather than starting on defaults and
      *     pretending to work.
      *
      *   - **OCI labels from the build.** `revision` in particular: it is the answer to "which commit
      *     is that container running", asked during every incident, and `docker inspect` answers it
      *     without anyone having to exec into anything.
      */
    trait KuiImage extends ScalaModule with DockerModule {
      def scalaVersion = Versions.scala

      /** The deployable this image wraps. */
      def deployable: JavaModule

      /** The repository name, without a tag. */
      def imageName: String

      /** The `main` this image starts. */
      def entryClass: String

      /** The port the process listens on, and the only one the image exposes. */
      def containerPort: Int = 8080

      /** The path the liveness probe is served at.
        *
        * It differs between the gateway and a service and that is not an inconsistency: the gateway
        * serves its own probes under the public `/api/v1` prefix, because everything a browser can
        * reach lives there, while a service serves them at the root of its private world.
        */
      def livenessPath: String

      /** A one-line description of the process, for the OCI `description` label. */
      def imageDescription: String

      def moduleDeps = Seq(deployable)
      def mainClass  = Some(entryClass)

      // The wrapper contributes no code of its own; it exists to name a main class and to be
      // assembled. Saying so explicitly stops Mill looking for directories that will never exist.
      def sources   = Task.Sources()
      def resources = Task.Sources()

      /** The assembled jar, rewritten so that two builds of one commit produce the same bytes.
        *
        * It overrides `assembly` rather than sitting beside it so that everything downstream — the
        * `COPY` in the generated Dockerfile and the copy the contributed docker module makes into
        * its build context — uses the normalised jar without having to know it exists.
        *
        * INFRA-001 asks for an image whose digest is a function of the commit it was built from,
        * and the reason it matters is not tidiness: a digest that changes on every build cannot be
        * used to answer "is the thing running in production the thing we reviewed". Every other
        * piece of the image is already deterministic — the base image is pinned by tag and never
        * re-pulled, the Dockerfile is generated from source, and `SOURCE_DATE_EPOCH` fixes the
        * layer and configuration timestamps. The jar was the one part that was not: Mill stamps
        * each zip entry with the moment it was written, so the last layer's content hash changed
        * every time and carried the whole digest with it.
        *
        * Two things are normalised, and they are the two things `reproducible-builds.org` names:
        *
        *   - **every entry's timestamp becomes a fixed local 1980-01-01**, the earliest instant the
        *     zip format can represent. `setTimeLocal` rather than `setTime` because the latter
        *     converts through the *machine's* time zone, so two developers in different zones would
        *     write different bytes for the same instant and the fix would only work on one of them;
        *   - **entries are written in sorted order**, so a directory listing that came back in a
        *     different order from the filesystem cannot reorder the archive.
        *
        * The shell prefix Mill puts in front of its assembly is dropped, because this jar is only
        * ever started with `java -jar` and a self-executing prefix is one more thing that would have
        * to be byte-stable for no benefit.
        */
      override def assembly: T[PathRef] = Task {
        import java.util.zip.{ZipEntry, ZipFile, ZipOutputStream}
        import scala.jdk.CollectionConverters.*

        val target = Task.dest / "app.jar"
        val fixedTime = java.time.LocalDateTime.of(1980, 1, 1, 0, 0, 0)
        val source = new ZipFile(super.assembly().path.toIO)

        try {
          val output = new ZipOutputStream(os.write.outputStream(target))
          try {
            source
              .entries()
              .asScala
              .toVector
              .sortBy(_.getName)
              .foreach { entry =>
                val copied = new ZipEntry(entry.getName)
                copied.setTimeLocal(fixedTime)
                output.putNextEntry(copied)
                if (!entry.isDirectory) {
                  val content = source.getInputStream(entry)
                  try content.transferTo(output)
                  finally content.close()
                }
                output.closeEntry()
              }
          } finally output.close()
        } finally source.close()

        PathRef(target)
      }

      object docker extends ClassicDockerConfig {
        def tags       = Task { Seq(s"$imageName:${kuiVersion()}") }
        def baseImage  = "eclipse-temurin:21-jre"

        // Never re-pull: a `:latest` base would make the image a function of when it was built,
        // which is exactly what the reproducibility requirement rules out. The tag here is fixed.
        def pullBaseImage = Task { false }

        def exposedPorts = Task { Seq(containerPort) }
        def user         = "1001"
        def envVars      = Task { Map("HOME" -> "/tmp", "TMPDIR" -> "/tmp") }

        def jvmOptions = Seq(
          "-XX:MaxRAMPercentage=75",
          "-XX:+ExitOnOutOfMemoryError",
          "-Djava.io.tmpdir=/tmp"
        )

        def labels = Task {
          Map(
            "org.opencontainers.image.title"       -> imageName,
            "org.opencontainers.image.description" -> imageDescription,
            "org.opencontainers.image.version"     -> kuiVersion(),
            "org.opencontainers.image.revision"    -> gitRevision(),
            "org.opencontainers.image.source"      -> "https://github.com/kui/kui",
            "org.opencontainers.image.licenses"    -> "Apache-2.0"
          )
        }

        /** The generated Dockerfile, plus the three things the contributed module cannot express:
          * the health check, the default command, and the jar's fixed name.
          *
          * The base `dockerfile` task copies the assembly under its own file name, which contains
          * the module path and would change if a module were renamed. Writing the whole file here
          * instead keeps the layout of the image stable and readable — one jar at `/app.jar` — and
          * puts every instruction in one place a reader can check against the conventions above.
          */
        override def dockerfile: T[String] = Task {
          val jar = assembly().path.last
          val renderedLabels = labels()
            .toSeq
            .sortBy(_._1)
            .map((key, value) => s"""LABEL "$key"="$value"""")
            .mkString("\n")
          val renderedEnv = envVars()
            .toSeq
            .sortBy(_._1)
            .map((key, value) => s"ENV $key=$value")
            .mkString("\n")
          val entrypoint =
            (Seq("java") ++ jvmOptions() ++ Seq("-jar", "/app.jar"))
              .map(argument => s""""$argument"""")
              .mkString(", ")

          s"""FROM ${baseImage()}
             |$renderedLabels
             |$renderedEnv
             |EXPOSE $containerPort/tcp
             |COPY $jar /app.jar
             |USER ${user()}
             |HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \\
             |  CMD curl -fsS http://127.0.0.1:$containerPort$livenessPath || exit 1
             |ENTRYPOINT [$entrypoint]
             |CMD ["--config", "$ConfigPath"]
             |""".stripMargin
        }

        /** `SOURCE_DATE_EPOCH` is what BuildKit reads instead of "now" when it has to write a
          * timestamp. See [[build]] for the other two halves of making that actually take effect.
          */
        override def dockerEnv = Task { super.dockerEnv() ++ Map("SOURCE_DATE_EPOCH" -> "0") }

        /** Builds the image so that the same commit produces the same digest.
          *
          * The contributed module's own `build` runs a plain `docker build`, which produces a
          * different digest every time even when nothing has changed. That is not a defect in it —
          * it is BuildKit's default behaviour — but it does defeat the one property INFRA-001 asks
          * for, and the reason that property matters is practical rather than tidy: a digest that
          * changes on every build cannot answer "is the image running in production built from the
          * commit we reviewed".
          *
          * Three flags are what make it hold, and each addresses a different source of drift:
          *
          *   - `rewrite-timestamp=true` on the exporter, which is what actually applies
          *     `SOURCE_DATE_EPOCH` to the files *inside* each layer. Setting the variable alone
          *     fixes the image's `created` field and leaves every copied file stamped with the
          *     moment it was copied, so the layer's content hash still changes on every build.
          *   - `--provenance=false`, because the provenance attestation records when and where the
          *     build ran, which is by definition different every time.
          *   - `--sbom=false`, for the same reason: the attestation is generated per build and
          *     becomes part of the manifest list.
          *
          * `unpack=false` comes along with the first of those because BuildKit refuses to rewrite
          * timestamps while also unpacking the image into the local snapshotter. The image is still
          * registered and still appears in `docker images`; it is unpacked the first time something
          * runs it, which costs a second once and nothing afterwards.
          *
          * The jar being copied in is normalised separately — see `assembly` above — because none of
          * these flags can help with an input whose own bytes differ.
          */
        /** The id the daemon currently holds for this image, or the empty string if it holds none.
          *
          * `build` below is a cached task: with unchanged sources Mill returns the tags it recorded
          * last time and does not run `docker buildx` at all. That is the right default for a task
          * whose output is a file under `out/`, and the wrong one here, because this task's real
          * output lives in the Docker daemon where Mill cannot see it. Deleting the image and
          * asking for it again therefore printed
          *
          *   1180/1180, SUCCESS] ./mill deployment.docker.gateway.docker.build
          *
          * against an image that did not exist, and anything trusting that exit code then ran
          * against whatever the daemon happened to hold. Wave 8 lost four gates to an image that
          * was merely stale; this is the same failure with the image absent, and it is worse
          * because the build it came from reported success.
          *
          * `Task.Input` is re-read on every invocation and participates in the cache key, so the
          * image disappearing invalidates the build that produced it and the next call rebuilds.
          * `check = false` because a missing image is the ordinary answer here, not an error.
          */
        def imageId: T[String] = Task.Input {
          // `imageName` is a plain `String` and not a task, which is what makes this readable from
          // an `Input` at all -- `Task.Input` may not call other tasks. Querying by repository
          // rather than by `tags()` costs nothing here: every tag this module writes shares the one
          // repository, so "the daemon holds none of them" is the condition worth invalidating on.
          try
            os.proc("docker", "images", "--quiet", imageName)
              .call(check = false, stderr = os.Pipe, stdout = os.Pipe)
              .out.text().trim
          catch
            // No daemon, or no `docker` on PATH. Returning a constant leaves the cache key stable,
            // so a machine that cannot answer the question is no worse off than before this input
            // existed; it is not made to rebuild on every invocation.
            case _: Throwable => "unknown"
        }

        override def build: T[Seq[String]] = Task {
          val context = Task.dest
          val jar = assembly().path

          // Read so that the image's absence is part of this task's cache key; see `imageId`.
          val _ = imageId()

          os.copy.over(jar, context / jar.last)
          os.write.over(context / "Dockerfile", dockerfile())

          val built = tags().head

          os.proc(
            executable(),
            "buildx",
            "build",
            "--provenance=false",
            "--sbom=false",
            "--output",
            s"type=docker,name=$built,rewrite-timestamp=true,unpack=false",
            context
          ).call(stdout = os.Inherit, stderr = os.Inherit, env = dockerEnv())

          tags().tail.foreach(extra =>
            os.proc(executable(), "tag", built, extra)
              .call(stdout = os.Inherit, stderr = os.Inherit, env = dockerEnv())
          )

          Task.log.info(s"built ${tags().mkString(", ")}")
          tags()
        }
      }
    }

    /** The one process a browser talks to. */
    object gateway extends KuiImage {
      def deployable       = services.gateway.app
      def imageName        = "kui-gateway"
      def entryClass       = "kui.gateway.app.Main"
      def livenessPath     = "/api/v1/health/live"
      def imageDescription = "KUI gateway: the single origin a browser talks to"
    }

    /** The Cluster Registry and Topology service. */
    object cluster extends KuiImage {
      def deployable       = services.cluster.app
      def imageName        = "kui-cluster"
      def entryClass       = "kui.cluster.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI cluster registry and topology service"
    }

    /** The Topic service: browsing topics, their partitions and their settings, and administering them. */
    object topic extends KuiImage {
      def deployable       = services.topic.app
      def imageName        = "kui-topic"
      def entryClass       = "kui.topic.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI topic service"
    }

    /** The Message service: browsing records, producing, resending and purging. */
    object message extends KuiImage {
      def deployable       = services.message.app
      def imageName        = "kui-message"
      def entryClass       = "kui.message.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI message browse and produce service"
    }

    /** The Consumer service: consumer groups, their lag and the offset reset. */
    object consumer extends KuiImage {
      def deployable       = services.consumer.app
      def imageName        = "kui-consumer"
      def entryClass       = "kui.consumer.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI consumer group and offset service"
    }

    /** The Schema service: subjects, versions, schemas and compatibility.
      *
      * It is packaged like every other service even though it is optional, and a deployment that
      * configures no registry can simply not run it. Running it anyway is also correct and is what the
      * all-in-one image does: it answers "not configured" for every cluster, which is the fact the
      * browser needs in order to hide the feature rather than show a broken screen.
      */
    object schema extends KuiImage {
      def deployable       = services.schema.app
      def imageName        = "kui-schema"
      def entryClass       = "kui.schema.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI schema registry service"
    }

    /** The Metrics service: broker throughput, and the measurements the dashboard's cards need.
      *
      * Packaged like every other service even though it measures nothing yet. A deployment can run it and
      * get an honest `not_configured` per cluster, or not run it and get the gateway's `unavailable` — and
      * those are different answers, which is exactly why it is a container rather than a flag.
      */
    object metrics extends KuiImage {
      def deployable       = services.metrics.app
      def imageName        = "kui-metrics"
      def entryClass       = "kui.metrics.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI metrics service"
    }

    object alerts extends KuiImage {
      def deployable       = services.alerts.app
      def imageName        = "kui-alerts"
      def entryClass       = "kui.alerts.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI alerts service"
    }

    /** The Connect service: the connectors each configured worker is running, and the three operations.
      *
      * Packaged like every other service even though most deployments configure no Connect cluster at all.
      * Running it then is correct and is what the all-in-one image does: it answers `not_configured` per
      * cluster, which is the fact the browser needs in order to hide the row rather than draw one that can
      * never fill. The image target is named here because the packet that adds the container cannot edit
      * this file (house rule 15).
      */
    object connect extends KuiImage {
      def deployable       = services.connect.app
      def imageName        = "kui-connect"
      def entryClass       = "kui.connect.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI Kafka Connect service"
    }

    /** The ksqlDB service: the objects, one statement at a time, and the push query.
      *
      * Packaged like every other service even though most deployments configure no ksqlDB at all, for the
      * connect image's reason: running it then answers `not_configured` per cluster, which is the fact the
      * browser needs in order to hide the row rather than draw one that can never fill. The image target is
      * named here because the packet that adds the container cannot edit this file (house rule 15).
      */
    object ksql extends KuiImage {
      def deployable       = services.ksql.app
      def imageName        = "kui-ksql"
      def entryClass       = "kui.ksql.app.Main"
      def livenessPath     = "/health/live"
      def imageDescription = "KUI ksqlDB service"
    }

    /** The whole product in one process (ADR-005). */
    object allinone extends KuiImage {
      def deployable       = apps.allinone
      def imageName        = "kui-allinone"
      def entryClass       = "kui.allinone.AllInOne"
      def livenessPath     = "/api/v1/health/live"
      def imageDescription = "KUI all-in-one: the gateway and every service in one process"
    }
  }
}

// -------------------------------------------------------------------------------------------------
// The developer loop (INFRA-003)
// -------------------------------------------------------------------------------------------------

/** Where `./mill devStart` writes the running process's id and its log. */
private def devPidFile   = mill.api.BuildCtx.workspaceRoot / "out" / "dev.pid"
private def devLogFile   = mill.api.BuildCtx.workspaceRoot / "out" / "dev.log"

/** The whole product on one port, with the frontend served straight out of the linker's output
  * directory.
  *
  * ==How the frontend gets served without being packaged==
  *
  * `StaticRoutes` serves `/ui/…` from the classpath under `/web`, so `/web/main.js` is what a browser
  * asks for. In a release build those files are bundled into the gateway's resources. Bundling them
  * for development would mean a copy step between "the linker wrote a new main.js" and "the server
  * can see it", and that copy step is exactly the thing that makes a frontend loop feel slow.
  *
  * So no copying happens at all. One extra classpath entry is put in *front* of the module
  * classpath: a directory whose `web` is a symbolic link to the Vite build's output.
  *
  * {{{
  * out/dev-assets/solid/web  ->  frontend/dist   (index.html, the hashed chunks, the stylesheet)
  * }}}
  *
  * A classloader searches classpath entries in order and takes the first hit, so every asset — and
  * `index.html` with it — resolves through that link. Re-running the Vite build rewrites the files
  * behind it, and a browser refresh is the whole loop: nothing is copied, nothing is restarted, and
  * no proxy is involved because the assets and the API share an origin (ADR-012 amendment 1).
  *
  * ==The log format==
  *
  * `text`, because a person is watching this. The images default to JSON, which is right when a log
  * collector is reading and unreadable when a human is. No OTLP exporter is configured either, so a
  * first run has no exporter warnings in it to explain away.
  */
def dev(): Task.Command[Unit] = Task.Command {
  val classPath = devClassPath()
  val port = devPortOf(Task.env)
  println(devBanner(port))
  os.proc(devCommand(classPath, port))
    .call(cwd = mill.api.BuildCtx.workspaceRoot, stdout = os.Inherit, stderr = os.Inherit, check = false)
  ()
}

/** The same server, detached, so a terminal is free for the frontend.
  *
  * Mill serialises invocations on its output directory, so a `./mill dev` holding the terminal also
  * holds that lock and every other `./mill` waits. Detaching releases it.
  *
  * The pair is therefore:
  *
  * {{{
  * cd frontend && pnpm build   # once, so there is an interface to serve
  * ./mill devStart             # the product, in the background
  * cd frontend && pnpm watch   # rebuilds on every save; refresh the browser
  * ./mill devStop              # when you are done
  * }}}
  *
  * `./mill dev` is still the right thing for a first run — it puts the log on the screen and stops
  * with Ctrl-C — and this is the right thing once you are editing.
  */
def devStart(): Task.Command[Unit] = Task.Command {
  stopDevServer()

  val classPath = devClassPath()
  val port = devPortOf(Task.env)
  os.write.over(devLogFile, "")

  val process = os
    .proc(devCommand(classPath, port))
    .spawn(
      cwd = mill.api.BuildCtx.workspaceRoot,
      stdout = devLogFile,
      // Appended to the same file rather than discarded: a bind failure — the commonest way this
      // command does not work — is written to standard error, and swallowing it would leave a
      // developer with a server that is silently not there.
      stderr = os.PathAppendRedirect(devLogFile),
      stdin = os.Inherit
    )

  os.write.over(devPidFile, process.wrapped.pid().toString)

  println(devBanner(port))
  println(s"  running in the background as pid ${process.wrapped.pid()}")
  println(s"  logs:  tail -f ${devLogFile.relativeTo(mill.api.BuildCtx.workspaceRoot)}")
  println(s"  watch: cd frontend && pnpm watch")
  println(s"  stop:  ./mill devStop")
}

/** Stops whatever `devStart` started. Saying nothing at all when there is nothing running, because a
  * stop command that fails when the thing is already stopped is a stop command people wrap in `|| true`.
  */
def devStop(): Task.Command[Unit] = Task.Command {
  if (stopDevServer()) println("stopped the development server") else println("nothing was running")
}

/** The classpath the development server runs on: the two live asset links, then everything the
  * all-in-one process would normally have.
  */
private def devClassPath = Task.Anon {
  // The interface, if somebody has built it, and nothing if not.
  //
  // Mill never *builds* the browser bundle — that is the frontend's own pnpm workspace, and keeping
  // it that way is what lets this build need only a JDK. But serving a directory somebody else built
  // costs nothing and is worth having: it gives one process on one port and one origin, which is the
  // shape the product actually ships in, and it is the quickest way to look at a change against a
  // real gateway without a second server or a proxy.
  //
  // Absent is not an error. A backend developer who has never run `pnpm build` should get a working
  // API and a 503 on `/ui/`, not a build that refuses to start over a directory they do not need.
  val assets = devSolidAssetLink().toList
  (assets ++ apps.allinone.runClasspath().map(_.path)).mkString(java.io.File.pathSeparator)
}

/** The classpath entry that puts a built interface in front of the gateway's own resources.
  *
  * A classloader takes the first hit on the classpath, so `index.html` and every hashed asset resolve
  * through this link and the gateway's `IndexHtml` substitution then runs over the page Vite wrote.
  * Both carry the same two markers, so the base path and the bootstrap block reach the browser
  * identically whether the gateway serves the interface or the frontend's own nginx does.
  *
  * Deliberately not a Mill task output. `pnpm watch` rewrites this directory continuously while the
  * server runs, and the point of a symbolic link is that the server reads whatever the last rebuild
  * wrote — a copy would be a snapshot, and a snapshot is a stale page.
  */
private def devSolidAssetLink(): Option[os.Path] = {
  val dist = mill.api.BuildCtx.workspaceRoot / "frontend" / "dist"
  Option.when(os.exists(dist)) {
    val root = mill.api.BuildCtx.workspaceRoot / "out" / "dev-assets" / "solid"
    val link = root / "web"
    os.remove.all(root)
    os.makeDir.all(root)
    os.symlink(link, dist)
    root
  }
}


/** The port the development server listens on. `KUI_PORT` overrides it, because 8080 is the most
  * contended port on a developer's machine and "it says nothing and answers nothing" is a miserable
  * first experience of a project.
  *
  * `Task.env` and not `sys.env`: Mill runs tasks inside a long-lived daemon, so `sys.env` is the
  * environment that daemon happened to be started with, not the one the developer just typed the
  * command in. Reading the wrong one produces a variable that appears to be ignored — and works
  * again, confusingly, after an unrelated `./mill shutdown`.
  */
private def devPortOf(env: Map[String, String]): String = env.getOrElse("KUI_PORT", "8080")

private def devCommand(classPath: String, devPort: String): Seq[String] =
  Seq(
    s"${System.getProperty("java.home")}/bin/java",
    "-cp",
    classPath,
    "kui.allinone.AllInOne",
    s"--kui.server.port=$devPort",
    // Readable on a terminal, and no exporter to fail to reach.
    "--kui.telemetry.logFormat=text",
    // Plain HTTP on localhost, so the session cookie cannot carry `Secure` or the browser will not
    // send it back. The process says so loudly on every start, and the warning is right.
    "--kui.server.devInsecureCookies=true"
  )

private def devBanner(devPort: String): String = {
  val dist = mill.api.BuildCtx.workspaceRoot / "frontend" / "dist"
  val ui =
    if os.exists(dist) then
      s"""  open   http://localhost:$devPort/ui/
         |  assets frontend/dist (served live; `cd frontend && pnpm watch` rebuilds, then refresh)"""
    else
      s"""  api    http://localhost:$devPort/api/v1
         |  ui     not built. Run `cd frontend && pnpm build`, then restart this server."""

  s"""kui development server
     |$ui""".stripMargin
}

/** Kills a previously started development server. Answers whether there was one. */
private def stopDevServer(): Boolean =
  if (!os.exists(devPidFile)) false
  else {
    val pid = scala.util.Try(os.read(devPidFile).trim.toLong).toOption
    os.remove(devPidFile)
    pid.exists { id =>
      val handle = ProcessHandle.of(id)
      handle.isPresent && handle.get().destroy()
    }
  }

/** The commit this build is being run from, or `unknown` when there is no git checkout.
  *
  * `unknown` rather than a failed build, because a release tarball and many build containers have no
  * `.git` directory and an image built from one is still a perfectly good image — it just cannot say
  * which commit it came from, which the label then states plainly instead of guessing.
  */
def gitRevision: T[String] = Task {
  gitHead().map(_.trim).filter(_.nonEmpty).getOrElse(BuildFacts.Unknown)
}

/** Small programs the build runs. They are ordinary modules so that their logic is unit-tested like
  * any other code, rather than living as untested script inside a Mill task.
  */
object tools extends Module {

  /** Renders `docs/api/error-codes.md` from the `ErrorCode` enum (KERN-008, ADR-034 amendment 2). */
  object errorCodes extends KuiJvmModule {
    override def moduleDir = mill.api.BuildCtx.workspaceRoot / "tools" / "error-codes"

    // `contracts-core` is here for the strings that never reach an OpenAPI document: the CSRF header
    // name (`HttpHeaders.Csrf`), the capability vocabulary and the stream event names. `security-core`
    // is here for the RBAC vocabulary the browser's permission store asks its questions in. Generating
    // all of them from the constants both halves already share is what makes them impossible to change
    // apart (ADR-048 §3).
    def moduleDeps = Seq(libs.kernel.jvm, libs.contractsCore.jvm, libs.securityCore.jvm)

    object test extends KuiCoverageTests
  }
}

/** Documents generated from code.
  *
  * A generated document is only trustworthy if something fails when it goes stale, so every task
  * here has a `--check` mode that CI runs: `./mill docs.errorCodes` writes the file, and
  * `./mill docs.errorCodes --check` fails when the committed file no longer matches the source it
  * was generated from.
  */
object docs extends Module {

  /** Where the generated table is committed. */
  private def errorCodesTarget: String =
    (mill.api.BuildCtx.workspaceRoot / "docs" / "api" / "error-codes.md").toString

  def errorCodes(args: String*): Command[Unit] = Task.Command {
    // Named and not `run`: the module holds two `main` methods (the Markdown table and the
    // browser's TypeScript constants), so the class to run has to be named. `runDocumentMain` and
    // not `runMain` for the third fact the task can report -- a fork that died before `main` --
    // which `runMain` renders identically to a stale committed table.
    tools.errorCodes.runDocumentMain("kui.tools.ErrorCodeDocMain", (errorCodesTarget +: args)*)()
  }
}

/** A module that exists only to be resolved, never compiled.
  *
  * It declares every Maven coordinate M0 will eventually use. `resolveAll` downloads the lot, so a
  * typo in a version string fails on the first day rather than on the day the module that needs the
  * library is finally written. It is deliberately not part of any real module's classpath.
  */
object depsSmoke extends KuiModule {
  def sources = Task.Sources()

  def mvnDeps = Seq(
    // Runtime core
    mvn"org.typelevel::cats-core::${Versions.cats}",
    mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
    mvn"co.fs2::fs2-core::${Versions.fs2}",
    mvn"co.fs2::fs2-io::${Versions.fs2}",
    // HTTP and contracts
    mvn"com.softwaremill.sttp.tapir::tapir-core::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-json-circe::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-iron::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-cats-effect::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-netty-server-cats::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-files::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-sttp-client4::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-openapi-docs::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-swagger-ui-bundle::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-otel4s-tracing::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-opentelemetry-metrics::${Versions.tapir}",
    mvn"com.softwaremill.sttp.tapir::tapir-sttp-stub4-server::${Versions.tapir}",
    mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
    mvn"com.softwaremill.sttp.client4::fs2::${Versions.sttp}",
    mvn"com.softwaremill.sttp.client4::circe::${Versions.sttp}",
    // JSON, config, validation, wiring
    mvn"io.circe::circe-core::${Versions.circe}",
    mvn"io.circe::circe-parser::${Versions.circe}",
    mvn"io.circe::circe-generic::${Versions.circe}",
    mvn"io.circe::circe-yaml::${Versions.circeYaml}",
    mvn"is.cir::ciris::${Versions.ciris}",
    mvn"is.cir::ciris-circe-yaml::${Versions.ciris}",
    mvn"io.github.iltotore::iron::${Versions.iron}",
    mvn"io.github.iltotore::iron-circe::${Versions.iron}",
    mvn"io.github.iltotore::iron-cats::${Versions.iron}",
    mvn"io.github.iltotore::iron-ciris::${Versions.iron}",
    mvn"com.softwaremill.macwire::macros::${Versions.macwire}",
    mvn"com.softwaremill.macwire::util::${Versions.macwire}",
    // Logging and telemetry
    mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
    mvn"org.typelevel::log4cats-slf4j::${Versions.log4cats}",
    mvn"org.slf4j:slf4j-api:${Versions.slf4j}",
    mvn"ch.qos.logback:logback-classic:${Versions.logback}",
    mvn"net.logstash.logback:logstash-logback-encoder:${Versions.logstash}",
    mvn"org.typelevel::otel4s-core::${Versions.otel4s}",
    mvn"org.typelevel::otel4s-oteljava::${Versions.otel4s}",
    mvn"org.typelevel::otel4s-oteljava-testkit::${Versions.otel4s}",
    mvn"io.opentelemetry:opentelemetry-sdk:${Versions.otelSdk}",
    mvn"io.opentelemetry:opentelemetry-sdk-extension-autoconfigure:${Versions.otelSdk}",
    mvn"io.opentelemetry:opentelemetry-exporter-otlp:${Versions.otelSdk}",
    // Tests
    mvn"org.scalameta::munit::${Versions.munit}",
    mvn"org.scalameta::munit-scalacheck::${Versions.munitScalacheck}",
    mvn"org.scalacheck::scalacheck::${Versions.scalacheck}",
    mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
    mvn"org.typelevel::discipline-munit::${Versions.disciplineMunit}",
    mvn"com.dimafeng::testcontainers-scala-munit::${Versions.testcontainers}"
  )
}

/** The layering rules of ADR-041 and the tests that prove each one fires.
  *
  * The rules themselves are compiled twice: once here, so they can be unit-tested against synthetic
  * module graphs, and once by the meta-build (`mill-build/build.mill`), so that `checkArchitecture`
  * below runs exactly the code these tests cover.
  */
object `build-tests` extends KuiPureModule with KuiJvmModule {
  object test extends KuiCoverageTests {

    /** The three files `BuildWiringSuite` opens at RUNTIME, declared so that Mill knows they are
      * inputs to this module's tests.
      *
      * `BuildWiringSuite` is the one suite here that reads the repository rather than a value: it
      * asserts that `build.mill` still routes every document generator through `runDocumentMain`,
      * that `frontend/package.json`'s `typecheck` script still names `e2e/tsconfig.json`, and that
      * `.github/workflows/ci.yml` still passes `--check` to the two hand-invoked generators. None
      * of the three is a source of this module, so Mill's input set for the cached test task did
      * not mention them.
      *
      * MEASURED AT THE WAVE-12 OPEN, BOTH WAYS, BECAUSE THE HOUSE RULE THIS REPAIRS WAS HALF RIGHT.
      * `./mill --no-daemon build-tests.test` is a *command*: it re-runs unconditionally, and with
      * `--check` deleted from `ci.yml`'s `docs.errorCodes` step it is RED with no `clean` in front
      * of it. `./mill --no-daemon build-tests.test.testCached` is the cached task, and over exactly
      * that mutation it printed `137/137, SUCCESS` in two seconds with no suite output at all —
      * the previous tree's answer, over a workflow that had stopped checking. So the hole is real
      * and it is in the cached task; the wave-11 note that named the command was measuring
      * something else.
      *
      * THE HASH HAS TO REACH A VALUE, WHICH IS WHY THIS IS NOT SIMPLY A `Task.Sources` BESIDE THE
      * MODULE. Mill invalidates a task when the VALUE its upstream produced changes, so depending
      * on these `PathRef`s from a task whose own result does not move re-runs nothing. `forkEnv`
      * carries the hashes into the environment the test JVM is started with: change one of the
      * three files and the map changes, and every task downstream of it — `testCached` included —
      * is out of date. The suite reads the same variable back and fails if it is missing, so
      * deleting this declaration is a red test rather than a silent return to caching.
      */
    def buildWiringInputs: T[Seq[PathRef]] = Task.Sources(
      mill.api.BuildCtx.workspaceRoot / "build.mill",
      mill.api.BuildCtx.workspaceRoot / ".github/workflows/ci.yml",
      mill.api.BuildCtx.workspaceRoot / "frontend/package.json",
      mill.api.BuildCtx.workspaceRoot / "deployment/frontend/Dockerfile"
    )

    override def forkEnv: T[Map[String, String]] = Task {
      val stamped = buildWiringInputs()
        .map(ref => s"${ref.path.relativeTo(mill.api.BuildCtx.workspaceRoot)}@${ref.sig}")
        .mkString(" ")
      super.forkEnv() + ("KUI_BUILD_WIRING_INPUTS" -> stamped)
    }
  }
}

/** Everything in this build that could have a dependency edge, as plain data.
  *
  * `depsSmoke` is excluded: it is a resolution probe, not a real module, and its whole purpose is
  * to declare every coordinate in the project at once.
  */
private def declaredModules: Seq[JavaModule] = moduleInternal.modules.collect {
  case m: JavaModule if m.moduleSegments.render != "depsSmoke" => m
}.toSeq

private def moduleGraph = Task.Anon {
  val modules           = declaredModules
  val declaredLibraries = Task.traverse(declaredModules)(_.mvnDeps)()

  modules.zip(declaredLibraries).map { (module, libraries) =>
    ModuleFacts(
      id = module.moduleSegments.render,
      moduleDeps = module.moduleDeps.map(_.moduleSegments.render).toSet,
      mvnDeps = libraries.map(coordinateOf).toSet
    )
  }.toList
}

/** `mvn"org.typelevel::cats-core::2.13.0"` becomes `org.typelevel:cats-core`.
  *
  * The version is dropped because the rules are about which library, not which release, and the
  * Scala suffix is dropped because `cats-core_3` and `cats-core_sjs1_3` are the same library.
  */
private def coordinateOf(dep: mill.scalalib.Dep): String = {
  val organization = dep.dep.module.organization.value
  val artifact     = dep.dep.module.name.value
  val bare = List("_sjs1_3", "_sjs1_2.13", "_3", "_2.13")
    .find(artifact.endsWith)
    .fold(artifact)(suffix => artifact.dropRight(suffix.length))
  s"$organization:$bare"
}

/** Fails the build on any module dependency that breaks the layering rules of ADR-041.
  *
  * This is what stops the hexagonal structure decaying. Nobody sets out to make `application`
  * depend on Tapir; someone needs one type, adds one edge, and the edge is invisible in every
  * later code review because reviewers read diffs, not dependency graphs. The check reports the
  * rule, both modules and the reason, so whoever trips it learns why in the same minute.
  */
def checkArchitecture(): Task.Command[Unit] = Task.Command {
  val modules    = moduleGraph()
  val violations = ArchitectureRules.check(modules)

  if (violations.isEmpty) {
    println(
      s"checkArchitecture: ${modules.size} modules, ${ArchitectureRules.ruleCount} rules, " +
        "no layering violations"
    )
  } else {
    val report = violations.map(v => s"  ${v.message}").mkString("\n")
    Task.fail(s"${violations.size} layering violation(s):\n$report")
  }
}

/** Downloads every coordinate M0 pins and prints how many were fetched. Exits non-zero on the first
  * version that does not exist, which is the whole point of the task.
  */
/** The pinned versions that something outside the build can read back.
  *
  * `Versions` above is a plain Scala object, evaluated while the build definition is being
  * compiled, so `./mill show Versions.playwright` cannot work — Mill can only show a *task*, which
  * is why these two are re-exported here.
  *
  * Nothing reads them today. They were added for a Scala Playwright e2e module that CI installed a
  * browser for by asking the build for the number; that module is gone, the browser suite is `pnpm
  * e2e` under `frontend/`, and both CI jobs install with `pnpm exec playwright install --with-deps
  * chromium` — which takes its version from `frontend/package.json` (1.63.0), not from here
  * (1.62.0). So `Versions.playwright` is an orphaned pin and this module its orphaned accessor;
  * `DEPENDENCY_MATRIX.md` records the same. Deleting both is the obvious follow-up and is left to
  * whoever owns the dependency registry, because the matrix's stated rule is to keep a version
  * written down even when no module uses it.
  */
object versions extends Module {
  def playwright: T[String]        = Task { Versions.playwright }
  def playwrightBrowser: T[String] = Task { Versions.playwrightBrowser }
}

def resolveAll(): Task.Command[Int] = Task.Command {
  val jars = depsSmoke.resolvedMvnDeps()
  println(s"resolved ${jars.toSeq.size} artifacts for ${depsSmoke.mvnDeps().size} pinned coordinates")
  jars.toSeq.size
}

/** The aggregate coverage report over every `ScoverageModule` in the build. It resolves
  * `__.scoverage.data` itself, so any `./mill __.test` run (or `scripts/run-tests.sh`) followed by
  * `./mill scoverage.xmlCoberturaReportAll` answers "how much of the tree did the suites that just
  * ran actually execute". `scripts/check-coverage.sh` is the ratchet over that answer, and the
  * reason the numbers exist at all: the `identity.api` module once shipped zero tests inside a
  * declared test module, and nothing could see it.
  */
object scoverage extends ScoverageReport {
  def scalaVersion     = Versions.scala
  def scoverageVersion = Versions.scoverage
}
