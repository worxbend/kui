      }

      object jvm extends Shared with KuiJvmModule {
        def moduleDeps = Seq(libs.contractsCore.jvm, libs.securityCore.jvm)

        object test extends KuiCoverageTests with KuiCrossTests
      }

    }
  }

  /** `kui-schema-service`: subjects, their versions, the schema behind each one, and compatibility.
    *
    * The first **optional** service in KUI, and it is shaped around that rather than around the feature. A
    * deployment with no `kui.clusters.<n>.schemaRegistry.url` runs this service, reports `not_configured` for
    * every cluster, and shows no schema screens — which is a different state from a registry that is down,
    * and the two must never look alike (ADR-032).
    */
  object schema extends Module {

    /** The registry's vocabulary and the port it is stated in terms of.
      *
      * Rule A1 allows it `libs/kernel` and cats-core, nothing else. What lives here is what has a wrong
      * answer that reaches a screen: the version selector that must not confuse "latest" with a number, the
      * compatibility levels whose wire spellings are the registry's and not KUI's, and the subject paging
      * whose count has to be taken after filtering rather than before it.
      */
    object domain extends KuiPureModule with KuiJvmModule {
      def moduleDeps = Seq(libs.kernel.jvm)
      def mvnDeps    = Seq(mvn"org.typelevel::cats-core::${Versions.cats}")

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm)
      }
    }

    /** The use cases: four reads, the compatibility check, and the one mutation with its audit record.
      *
      * `libs/security-core` is here for `AuditSink` and `Principal`: the compatibility write is audited with
      * the person the gateway signed, which is a fact this layer has to hold rather than one the adapter can
      * reconstruct.
      */
    object application extends KuiJvmModule {
      def moduleDeps = Seq(domain, libs.securityCore.jvm)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}"
