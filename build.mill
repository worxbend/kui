        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}"
        )
      }
    }

    /** The adapters: the registry's REST API over `libs/http`'s resilient backend, the OAuth token source,
      * and the configured cluster list.
      *
      * There is no Kafka client anywhere in this service's tree. A Schema Registry is an HTTP service, and
      * the only thing this service reads from `kui.clusters[]` is which registries exist and how to
      * authenticate to them — which is why `libs.kafka` is absent here and present in every other service.
      */
    object infrastructure extends KuiJvmModule {
      def moduleDeps =
        Seq(domain, application, libs.config, libs.http, libs.observability, libs.kernel.jvm)

      def mvnDeps = Seq(
        mvn"org.typelevel::cats-core::${Versions.cats}",
        mvn"org.typelevel::cats-effect::${Versions.catsEffect}",
        mvn"io.circe::circe-core::${Versions.circe}",
        mvn"io.circe::circe-parser::${Versions.circe}",
        mvn"com.softwaremill.sttp.client4::core::${Versions.sttp}",
        mvn"com.softwaremill.sttp.client4::cats::${Versions.sttp}",
        mvn"org.typelevel::log4cats-core::${Versions.log4cats}",
        mvn"org.typelevel::otel4s-core::${Versions.otel4s}"
      )

      object test extends KuiCoverageTests {
        def moduleDeps = super.moduleDeps ++ Seq(libs.testkit.jvm, domain.test)

        def mvnDeps = super.mvnDeps() ++ Seq(
          mvn"org.typelevel::munit-cats-effect::${Versions.munitCatsEffect}",
          // Virtual time, requested by W6-A2 and added here because `build.mill` has one owner per
          // wave: the token cache's expiry is a rule about what is true *after* a TTL, and a suite that
          // slept through one would be slow on every run and flaky on a loaded machine. `libs/cache`'s
          // own test module already carries this dependency for exactly that reason.
          mvn"org.typelevel::cats-effect-testkit::${Versions.catsEffect}"
        )
      }
    }

