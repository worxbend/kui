{
  "name": "@kui/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The contract seam: types generated from the committed OpenAPI document, and the typed client every request goes through",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../../docs/api/openapi.browser.json --output src/schema.d.ts --immutable --alphabetize"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "openapi-typescript-helpers": "0.1.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "vitest": "5.0.1"
  }
}
