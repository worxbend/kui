{
  "name": "@kui/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc --build --pretty false && tsc --noEmit --pretty false -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:messages": "playwright test e2e/messages.spec.ts",
    "e2e:install": "playwright install chromium",
    "capture:readme": "node --experimental-strip-types e2e/capture-readme.ts",
    "e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006 --no-open",
    "test:storybook-docgen": "node --experimental-strip-types --test .storybook/docgen.test.mjs",
    "build-storybook": "pnpm test:storybook-docgen && storybook build",
    "storybook:ci": "pnpm build-storybook && pnpm exec http-server storybook-static -p 6017 -s",
    "a11y": "node scripts/a11y-stories.mjs",
    "bundle-shape": "node scripts/bundle-shape.mjs",
    "lint:boundaries": "node scripts/boundaries.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.3",
    "@vitest/browser": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "axe-core": "4.13.0",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "storybook-solidjs-vite": "10.7.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.21",
    "@solidjs/web": "2.0.0-rc.6",
    "solid-js": "2.0.0-rc.6"
  },
  "kui": {
    "pinnedPrereleaseDependencies": {
      "_comment": "No stable solid-js 2.x line exists yet (checked npm 2026-09-17: solid-js/@solidjs/web latest is 2.0.0-rc.8, @solidjs/router latest is 2.0.0-next.24 - still no beta/rc cut). These pins are a deliberate, time-boxed exception, not an oversight: pre-release/next tags carry no stability or patch guarantees and can be republished or yanked without notice. Re-check upstream release notes each review cycle and move to the first stable 2.0.0 tag as soon as one ships (mirror the bump into every workspace package.json, not just this one).",
      "solid-js": "2.0.0-rc.6",
      "@solidjs/web": "2.0.0-rc.6",
      "@solidjs/router": "2.0.0-next.21",
      "reviewBy": "2026-12-31"
    }
  }
}
