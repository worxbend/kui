{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "KUI Identity service",
    "version" : "1.0.0"
  },
  "paths" : {
    "/identity/settings" : {
      "get" : {
        "tags" : [
          "identity"
        ],
        "summary" : "Which kind of sign-in this deployment uses",
        "operationId" : "identity.settings",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthSettingsDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/identity/login" : {
      "post" : {
        "tags" : [
          "identity"
        ],
        "summary" : "Sign in with a username and a password",
        "operationId" : "identity.login",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: body",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/identity/password" : {
      "post" : {
        "tags" : [
          "identity"
        ],
        "summary" : "Set a new password, completing a required change",
        "operationId" : "identity.password.change",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : ""
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: body",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/identity/permissions" : {
      "get" : {
        "tags" : [
          "identity"
        ],
        "summary" : "What the calling principal is allowed to do",
        "operationId" : "identity.permissions",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PermissionsResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/identity/oidc/start" : {
      "post" : {
        "tags" : [
          "identity"
        ],
        "summary" : "Where to send the browser to sign in with the configured provider",
        "operationId" : "identity.oidc.start",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OidcStartResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/identity/oidc/callback" : {
      "post" : {
        "tags" : [
          "identity"
        ],
        "summary" : "Turn a provider's authorization code into a KUI principal",
        "operationId" : "identity.oidc.callback",
        "parameters" : [
          {
            "name" : "X-Kui-Principal",
            "in" : "header",
            "required" : true,
            "schema" : {
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OidcCallbackRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid value for: header X-Kui-Principal, Invalid value for: body",
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/health/live" : {
      "get" : {
        "description" : "Whether the process should be restarted. Never depends on an upstream.",
        "operationId" : "health.live",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LivenessReport"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready" : {
      "get" : {
        "description" : "Whether the service can serve requests now, and which checks say otherwise.",
        "operationId" : "health.ready",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ReadinessReport"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/capabilities" : {
      "get" : {
        "description" : "What this service can currently do, per cluster.",
        "operationId" : "capabilities",
        "responses" : {
          "200" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ServiceCapabilities"
                }
              }
            }
          },
          "default" : {
            "description" : "",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "AuthSettingsDto" : {
        "title" : "AuthSettingsDto",
        "type" : "object",
        "required" : [
          "authType",
          "rbacEnabled"
        ],
        "properties" : {
          "authType" : {
            "type" : "string"
          },
          "providerLabel" : {
            "type" : "string"
          },
          "rbacEnabled" : {
            "type" : "boolean"
          }
        }
      },
      "ChangePasswordRequest" : {
        "title" : "ChangePasswordRequest",
        "type" : "object",
        "required" : [
          "challenge",
          "newPassword"
        ],
        "properties" : {
          "challenge" : {
            "type" : "string"
          },
          "newPassword" : {
            "type" : "string"
          }
        }
      },
      "CheckResult" : {
        "title" : "CheckResult",
        "description" : "One readiness check and its result",
        "type" : "object",
        "required" : [
          "name",
          "healthy"
        ],
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "healthy" : {
            "type" : "boolean"
          },
          "detail" : {
            "type" : "string"
          }
        }
      },
      "ClusterCapability" : {
        "title" : "ClusterCapability",
        "type" : "object",
        "required" : [
          "configured",
          "status"
        ],
        "properties" : {
          "configured" : {
            "type" : "boolean"
          },
          "features" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "status" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "reason" : {
            "type" : "string"
          }
        }
      },
      "ErrorDetail" : {
        "title" : "ErrorDetail",
        "description" : "One request field and every rule it breaks",
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "restrictions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "ErrorEnvelope" : {
        "title" : "ErrorEnvelope",
        "description" : "The error shape every KUI endpoint returns (ADR-034)",
        "type" : "object",
        "required" : [
          "code",
          "message",
          "correlationId",
          "timestamp",
          "retryable"
        ],
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "details" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ErrorDetail"
            }
          },
          "correlationId" : {
            "type" : "string"
          },
          "timestamp" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          },
          "retryable" : {
            "type" : "boolean"
          }
        }
      },
      "GrantDto" : {
        "title" : "GrantDto",
        "type" : "object",
        "required" : [
          "resource",
          "defaultRole"
        ],
        "properties" : {
          "clusters" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "resource" : {
            "type" : "string"
          },
          "value" : {
            "type" : "string"
          },
          "actions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "defaultRole" : {
            "type" : "boolean"
          }
        }
      },
      "IdentityPrincipalDto" : {
        "title" : "IdentityPrincipalDto",
        "type" : "object",
        "required" : [
          "name",
          "kind"
        ],
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "kind" : {
            "type" : "string"
          }
        }
      },
      "LivenessReport" : {
        "title" : "LivenessReport",
        "description" : "Whether the process should be restarted",
        "type" : "object",
        "required" : [
          "alive",
          "at"
        ],
        "properties" : {
          "alive" : {
            "type" : "boolean"
          },
          "at" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          }
        }
      },
      "LoginRequest" : {
        "title" : "LoginRequest",
        "type" : "object",
        "required" : [
          "username",
          "password"
        ],
        "properties" : {
          "username" : {
            "type" : "string"
          },
          "password" : {
            "type" : "string"
          }
        }
      },
      "LoginResponse" : {
        "title" : "LoginResponse",
        "oneOf" : [
          {
            "$ref" : "#/components/schemas/PasswordChangeRequired"
          },
          {
            "$ref" : "#/components/schemas/SignedIn"
          }
        ]
      },
      "Map_ClusterId_ClusterCapability" : {
        "title" : "Map_ClusterId_ClusterCapability",
        "type" : "object",
        "additionalProperties" : {
          "$ref" : "#/components/schemas/ClusterCapability"
        }
      },
      "OidcCallbackRequest" : {
        "title" : "OidcCallbackRequest",
        "type" : "object",
        "required" : [
          "code",
          "state"
        ],
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "state" : {
            "type" : "string"
          }
        }
      },
      "OidcStartResponse" : {
        "title" : "OidcStartResponse",
        "type" : "object",
        "required" : [
          "authorizationUrl",
          "state"
        ],
        "properties" : {
          "authorizationUrl" : {
            "type" : "string"
          },
          "state" : {
            "type" : "string"
          }
        }
      },
      "PasswordChangeRequired" : {
        "title" : "PasswordChangeRequired",
        "type" : "object",
        "required" : [
          "challenge"
        ],
        "properties" : {
          "challenge" : {
            "type" : "string"
          }
        }
      },
      "PermissionsResponse" : {
        "title" : "PermissionsResponse",
        "type" : "object",
        "properties" : {
          "permissions" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/GrantDto"
            }
          }
        }
      },
      "ReadinessReport" : {
        "title" : "ReadinessReport",
        "description" : "Whether the service can serve requests now",
        "type" : "object",
        "required" : [
          "ready",
          "at"
        ],
        "properties" : {
          "ready" : {
            "type" : "boolean"
          },
          "checks" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CheckResult"
            }
          },
          "at" : {
            "description" : "RFC 3339 timestamp in UTC",
            "type" : "string"
          }
        }
      },
      "ServiceCapabilities" : {
        "title" : "ServiceCapabilities",
        "type" : "object",
        "required" : [
          "service",
          "clusters"
        ],
        "properties" : {
          "service" : {
            "description" : "a KUI service: cluster, topic, message, ...",
            "type" : "string"
          },
          "clusters" : {
            "$ref" : "#/components/schemas/Map_ClusterId_ClusterCapability"
          }
        }
      },
      "SignedIn" : {
        "title" : "SignedIn",
        "type" : "object",
        "required" : [
          "principal"
        ],
        "properties" : {
          "principal" : {
            "$ref" : "#/components/schemas/IdentityPrincipalDto"
          }
        }
      }
    }
  }
}
