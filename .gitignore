# Mill build output
out/

# IDE and build-server metadata
.bsp/
.metals/
.bloop/
.idea/

# Frontend build artifacts
node_modules/
frontend/dist/

# `pnpm build-storybook`. It is a CI step and it is also the input the a11y sweep runs against, so
# every developer who checks the gate before pushing leaves ~11MB of it behind; untracked, it makes
# `git status` unreadable for everyone who does. No trailing slash, unlike its neighbours, so that
# `git check-ignore frontend/storybook-static` answers the same before the build has ever run.
frontend/storybook-static

# Playwright's own output: the HTML report and the per-test traces, videos and screenshots it keeps
# for a failure. Regenerable by re-running the suite, and a trace is megabytes.
frontend/playwright-report/
frontend/test-results/

# `pnpm test:coverage` output. Regenerable on every run; CI uploads it as an artifact, so nobody
# needs it in `git status`.
frontend/coverage/

# Generated by deployment/secured/generate-certs.sh: a throwaway certificate authority for the
# secured-broker stack. Worthless, regenerable, and still not something to keep in a repository.
deployment/secured/certs/

# Scratch directory for a one-off secured-broker run; deployment/secured/ is the committed form.
.secure-e2e/

# TypeScript project-reference build state (frontend/tsconfig*.json)
frontend/.tsbuild/

# Storybook's static build. Produced by `pnpm build-storybook`, which the a11y gate runs on every
# check, so without this every run leaves 11 MB of untracked output in `git status` — and the agents
# and people who read that status to see what a change touched lose the signal in the noise.
frontend/storybook-static/

# The gateway session the end-to-end suite shares across cases (frontend/e2e/session.ts).
frontend/playwright/.auth/
